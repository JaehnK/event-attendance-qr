# 42 앱 자격증명 (https://profile.intra.42.fr/oauth/applications, scope: public)
FT_UID=u-s4t2ud-...
FT_SECRET=s-s4t2ud-...
# 42 앱에 등록한 Redirect URI와 정확히 같아야 한다.
REDIRECT_URI=https://<프로젝트>.vercel.app/callback
# Apps Script 웹앱 /exec URL
GAS_URL=https://script.google.com/macros/s/<배포ID>/exec
# Apps Script 스크립트 속성 TOKEN과 같은 값. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
GAS_TOKEN=
# QR·세션 서명용 긴 랜덤 문자열. 바꾸면 기존 QR과 세션이 모두 무효가 된다.
SESSION_SECRET=
# QR에 들어갈 주소
BASE_URL=https://<프로젝트>.vercel.app
# /qr 접근 가능한 관리자 인트라 ID(쉼표 구분, 대소문자 무시). 비어 있으면 아무도 접근할 수 없다.
ADMIN_LOGINS=
